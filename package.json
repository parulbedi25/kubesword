{
  "name": "kubesword",
  "version": "1.0.0",
  "description": "KubeSword — Web-based Kubernetes cluster monitoring & management (Lens / Headlamp alternative). Runs in any browser and as a desktop app for Windows, macOS and Linux.",
  "author": "KubeSword Contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "smoke": "node scripts/smoke.js",
    "desktop": "electron .",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:electron": "concurrently -n server,client,electron -c blue,green,magenta \"npm run dev -w server\" \"npm run dev -w client\" \"wait-on http://localhost:5173 http://localhost:3001/api/health && electron .\"",
    "web": "npm run build && node server/dist/index.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:installer": "npm run build && electron-builder --win nsis",
    "dist:win:portable": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:mac:intel": "npm run build && electron-builder --mac --x64",
    "dist:mac:all": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "pack": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "electron": "^32.3.3"
  },
  "build": {
    "appId": "com.kubesword.app",
    "productName": "KubeSword",
    "copyright": "Copyright © 2026 KubeSword Contributors",
    "compression": "maximum",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "server/dist/**/*",
      "client/dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/dist/**/*",
      "server/package.json",
      "client/dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "KubeSword-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "KubeSword-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KubeSword"
    },
    "portable": {
      "artifactName": "KubeSword-${version}-win-${arch}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "KubeSword-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "11.0.0",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        { "x": 140, "y": 200, "type": "file" },
        { "x": 400, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "KubeSword-${version}-linux-${arch}.${ext}",
      "category": "Development",
      "maintainer": "KubeSword Contributors",
      "description": "Web-based Kubernetes cluster monitoring & management tool"
    }
  }
}
